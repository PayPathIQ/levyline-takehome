# Your local Postgres database. See "Getting started" in the README.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/levyline

# Email. Leave RESEND_API_KEY empty to use the local mailbox in .mailbox/
# (nothing leaves your machine). See "Email set-up" in the README.
RESEND_API_KEY=
# The sender. Without your own domain on Resend, use onboarding@resend.dev.
EMAIL_FROM=Levyline <onboarding@resend.dev>
# Every email goes here instead of to the owner, because the owners in the
# sample data aren't real. Use the address you signed up to Resend with.
EMAIL_REDIRECT_TO=
# Your Resend receiving domain, e.g. abc123.resend.app (Emails > Receiving).
EMAIL_RECEIVING_DOMAIN=
# Signing secret of your Resend webhook endpoint (starts with whsec_). The
# value below is only for the local reply simulator.
RESEND_WEBHOOK_SECRET=whsec_bG9jYWwtc2ltdWxhdG9yLXNlY3JldC0xMjM0NTY=
